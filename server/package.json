{
  "name": "@ugs/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "import:legacy": "tsx --env-file-if-exists=.env scripts/import-legacy.ts",
    "build:library": "tsx --env-file-if-exists=.env scripts/rebuild.ts",
    "refresh:prices": "tsx --env-file-if-exists=.env scripts/refresh.ts prices",
    "refresh:genres": "tsx --env-file-if-exists=.env scripts/refresh.ts genres",
    "refresh:ci": "tsx --env-file-if-exists=.env scripts/ci-refresh.ts",
    "build:netlify": "tsx --env-file-if-exists=.env scripts/build-netlify.ts",
    "parity": "tsx --env-file-if-exists=.env scripts/parity.ts",
    "check:delivery": "tsx --env-file-if-exists=.env scripts/check-delivery.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@ugs/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "entities": "^8.1.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
